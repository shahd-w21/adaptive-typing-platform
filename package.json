{
  "name": "typeflow",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": ["client", "server", "packages/shared"],
  "engines": { "node": ">=24.14.0 <25", "npm": ">=11 <12" },
  "scripts": {
    "setup:env": "node scripts/setup-env.js",
    "dev": "concurrently --kill-others -n client,server \"npm run dev:client\" \"npm run dev:server\"",
    "dev:client": "npm run dev --workspace=client -- --host 127.0.0.1 --port 5173 --strictPort",
    "dev:server": "npm run dev --workspace=server",
    "lint": "npm run lint --workspace=client && eslint server/src server/tests packages/shared/src scripts eslint.config.js",
    "test": "node --test server/tests/unit/*.test.js",
    "test:integration": "node scripts/database.js test",
    "build": "npm run db:generate && npm run build --workspace=client && node --check server/src/server.js",
    "db:up": "docker compose up -d --wait db mailpit",
    "db:stop": "docker compose stop db mailpit",
    "db:generate": "npm run db:generate --workspace=server",
    "db:seed": "node scripts/database.js seed",
    "db:migrate": "node scripts/database.js migrate",
    "db:migration:create": "node scripts/database.js create",
    "db:studio": "node scripts/database.js studio"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "concurrently": "^9.2.1",
    "dotenv": "^18.0.7",
    "eslint": "^10.10.0",
    "globals": "^17.12.0"
  }
}
